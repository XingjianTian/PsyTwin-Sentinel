# ==========================================
# 数据库配置（必需）
# ==========================================
POSTGRES_USER=psytwin
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=psytwin_sentinel
POSTGRES_PORT=5432
DATABASE_URL="postgresql://psytwin:your_password_here@localhost:5432/psytwin_sentinel?schema=public"

# Redis（docker-compose.dev.yml 会同时启动）
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD="replace-with-a-local-redis-password"
REDIS_DB=0
REDIS_URL="redis://:replace-with-a-local-redis-password@127.0.0.1:6379/0"

# ==========================================
# AI 服务配置（可选，但推荐配置以获得完整功能）
# ==========================================
# 阿里云 Dashscope API Key（用于 Qwen 大模型）
# 获取地址：https://dashscope.aliyun.com/
DASHSCOPE_API_KEY="your-dashscope-api-key-here"

# OpenAI API Key（可选，用于嵌入模型）
# 如果不配置，将使用文本搜索替代向量搜索
OPENAI_API_KEY="your-openai-api-key-here"

# ==========================================
# JWT 认证配置（生产环境必需）
# ==========================================
# 使用至少 32 字节的随机值；生产环境会拒绝缺失值和此占位值
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_ISSUER="psytwin-sentinel"
JWT_AUDIENCE="psytwin-sentinel"

# ==========================================
# 应用配置（可选）
# ==========================================
# 应用名称和版本
NEXT_PUBLIC_APP_NAME="PsyTwin Sentinel"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# ==========================================
# LightRAG 知识库服务配置（可选，但推荐）
# ==========================================
# 本地 Docker 部署时通常保持 localhost:9621
# 如果 Sentinel 部署在服务器上，请改成浏览器可以访问到的服务器地址
NEXT_PUBLIC_LIGHTRAG_WEBUI_URL="http://42.121.14.189:9621"

# 服务端 RAG 检索接口地址，通常与 NEXT_PUBLIC_LIGHTRAG_WEBUI_URL 保持一致
LIGHTRAG_API_URL="http://42.121.14.189:9621"

# 必须与 LightRAG 服务端配置的 LIGHTRAG_API_KEY 一致；仅保留在服务端
LIGHTRAG_API_KEY="replace-with-the-lightrag-api-key"
LIGHTRAG_QUERY_MODE="hybrid"
LIGHTRAG_MAX_CONTEXT_TOKENS=6000

# 这里只是前端提示文案，不参与真实鉴权
NEXT_PUBLIC_LIGHTRAG_API_KEY_HINT="psytwin-local-rag-key"

# ==========================================
# OpenClaw Gateway 配置（可选）
# ==========================================
# OpenClaw Gateway WebSocket 地址
OPENCLAW_GATEWAY_URL="ws://127.0.0.1:18789"

# 小程序本地心宠服务所在电脑的局域网 IP（端口固定为 13002）
NEXT_PUBLIC_PET_SYNC_HOST="192.168.0.105"

# 高级覆盖：仅在使用 WSS、反向代理或自定义端口时启用
# NEXT_PUBLIC_PET_SYNC_WS_URL="wss://pet.example.com/ws/pet"
# OpenClaw Gateway 访问令牌（仅服务端使用）
OPENCLAW_GATEWAY_TOKEN="your-openclaw-gateway-token"

# 可选：外部 OpenClaw 配置文件路径及兼容令牌名
# OPENCLAW_CONFIG_PATH="C:/path/to/openclaw.json"
# OPENCLAW_TOKEN="your-openclaw-gateway-token"

# ==========================================
# 心宠 AI / Reachy Mini 内部服务
# ==========================================
# 仅由 Sentinel 服务端访问，不要使用 NEXT_PUBLIC_ 前缀
CLAWBODY_SERVICE_URL="http://127.0.0.1:7860"
CLAWBODY_SERVICE_KEY="replace-with-the-same-key-as-clawbody"
HOST_BRIDGE_URL="http://127.0.0.1:7861"
HOST_BRIDGE_API_KEY="replace-with-the-same-key-as-clawbody-host-bridge"
PET_AI_DEMO_STUDENT_ID="stu-test"

# 可选：Unity/WebRTC 串流页面地址
# NEXT_PUBLIC_UNITY_STREAM_URL="http://127.0.0.1:8080"
